# ========== 编译阶段 ==========
FROM ubuntu:26.04 AS builder

ARG DEBIAN_FRONTEND=noninteractive
ARG FFMPEG_VERSION=n9.0.1

# 安装编译依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential yasm nasm cmake git pkg-config autoconf automake libtool \
    libva-dev libdrm-dev libx11-dev libxext-dev libxfixes-dev \
    libx264-dev libx265-dev libvpx-dev libvorbis-dev libopus-dev \
    libmp3lame-dev libfdk-aac-dev libass-dev libfreetype6-dev \
    libtheora-dev libvorbis-dev libxcb1-dev libxcb-shm0-dev libxcb-xfixes0-dev \
    zlib1g-dev texinfo wget && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch ${FFMPEG_VERSION} https://github.com/FFmpeg/FFmpeg.git ffmpeg

WORKDIR /src/ffmpeg
RUN ./configure \
    --prefix=/opt/ffmpeg \
    --enable-gpl \
    --enable-nonfree \
    --enable-shared \
    --enable-vaapi \
    --enable-libdrm \
    --enable-libx264 \
    --enable-libx265 \
    --enable-libvpx \
    --enable-libvorbis \
    --enable-libopus \
    --enable-libmp3lame \
    --enable-libfdk-aac \
    --enable-libass \
    --enable-libfreetype \
    --enable-libtheora \
    --enable-decoder=h264_vaapi,hevc_vaapi,vp9_vaapi,av1_vaapi \
    --enable-encoder=h264_vaapi,hevc_vaapi,vp9_vaapi,av1_vaapi \
    && make -j$(nproc) && make install

# 自动探测 ffmpeg 二进制/共享库真正依赖的运行时包名，避免在不同 Ubuntu 版本
# 上硬编码 libx264-164 / libvpx7 等 SO 版本号导致 apt 找不到包
RUN ldd /opt/ffmpeg/bin/* /opt/ffmpeg/lib/*.so* 2>/dev/null \
      | awk '/=> \// {print $3}' | sort -u \
      | xargs -r dpkg -S 2>/dev/null \
      | cut -d: -f1 | sort -u \
      | grep -E '^lib' | grep -v -- '-dev$' \
      > /opt/ffmpeg-runtime-packages.txt

# ========== 运行阶段 ==========
FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive

# 从编译阶段拷贝 FFmpeg 与自动生成的运行时依赖清单
COPY --from=builder /opt/ffmpeg /opt/ffmpeg
COPY --from=builder /opt/ffmpeg-runtime-packages.txt /tmp/ffmpeg-runtime-packages.txt

# 只装运行时依赖 + VA-API 驱动（lib* 部分由上一步自动探测得出）
RUN apt-get update && apt-get install -y --no-install-recommends \
    libva2 libva-drm2 libva-x11-2 libdrm2 \
    intel-media-va-driver-non-free \
    i965-va-driver \
    vainfo \
    $(cat /tmp/ffmpeg-runtime-packages.txt | tr '\n' ' ') && \
    rm -rf /var/lib/apt/lists/* /tmp/ffmpeg-runtime-packages.txt

ENV PATH=/opt/ffmpeg/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/ffmpeg/lib:$LD_LIBRARY_PATH
ENV LIBVA_DRIVER_NAME=iHD

# 保持容器常驻,方便通过 docker exec 进入使用 ffmpeg
WORKDIR /src
CMD ["sleep", "infinity"]